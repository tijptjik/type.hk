{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "type-hk",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/os-previews/*",
      "/project-previews/*",
      "/os-icons/*",
      "/rose-punk-icons/*",
      "/rose-punk-releases/*",
      "/run-particles.gif",
      "/run-particles.webp"
    ]
  },
  "routes": [
    {
      "pattern": "type.hk/*",
      "zone_id": "bd5c5900001411ea1036620c4bb3d754"
    }
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tjikos-assets"
    }
  ]
}
