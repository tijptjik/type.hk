{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "type-hk",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "type.hk/*",
      "zone_id": "bd5c5900001411ea1036620c4bb3d754"
    }
  ],
  "observability": {
    "enabled": true
  }
}
