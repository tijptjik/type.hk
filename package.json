{
  "name": "type-hk",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/check-assets.py && vite build && bun run cf-typegen",
    "capture-preview": "bun run scripts/capture-preview.ts",
    "cf-typegen": "wrangler types --env-interface Env",
    "i18n:build": "paraglide-js compile --project ./project.inlang",
    "check": "bun run i18n:build && bun run cf-typegen && svelte-check --tsconfig ./tsconfig.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "preview": "vite preview",
    "preview:worker": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "assets:upload": "python3 scripts/publish-assets.py",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/monaspace-argon": "^5.3.0",
    "@fontsource/monaspace-krypton": "^5.3.0",
    "@fontsource/monaspace-xenon": "^5.3.0",
    "@iconify-json/proicons": "^1.2.21",
    "@iconify-json/selfhst": "^1.2.33",
    "@iconify-json/simple-icons": "^1.2.103",
    "@iconify/svelte": "^5.2.4",
    "@inlang/paraglide-js": "3.2.2",
    "@lucide/svelte": "^1.77.0",
    "bits-ui": "^2.22.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.59.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "husky": "^9.1.7",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "mdsvex": "^1.0.1",
    "playwright": "^1.65.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
